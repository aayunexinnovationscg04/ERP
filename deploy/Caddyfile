# Aayunex — Caddy config (source-of-truth copy of /etc/caddy/Caddyfile)
#
# TWO jobs now:
#   1. Legacy receiver-dashboard for the ESP32 device  (unchanged)
#   2. HTTPS front for the Fuel Guard X ERP subdomains -> nginx apps
#
# Do NOT add a redirect to the device's plain-HTTP block: the SIM800L will not
# follow a 3xx and telemetry would silently stop.

# ---- Legacy device dashboard (unchanged) ----
http://dashboard.aayunexinnovations.com {
	reverse_proxy 127.0.0.1:8080
}
https://dashboard.aayunexinnovations.com {
	reverse_proxy 127.0.0.1:8080
}
http://31.42.125.144, http://:80 {
	reverse_proxy 127.0.0.1:8080
}

# ---- Fuel Guard X ERP (automatic Let's Encrypt HTTPS) ----
# One subdomain per portal; nginx on 127.0.0.1:8090 routes by Host header:
#   erp.     -> landing page ("choose your portal") + 301s for old /dealer/ /pilot/ /admin/ links
#   dealer.  -> Dealer ERP     (+ /api/)
#   pilot.   -> Pilot ERP      (+ /api/)
#   admin.   -> Admin ERP      (+ /api/ + /django-admin/)
# Caddy obtains and renews a certificate for every hostname below on its own
# (ACME / Let's Encrypt) and redirects HTTP -> HTTPS, so certbot is not needed.
(fuelguardx_erp) {
	# HSTS belongs at the TLS terminator. Other security headers come from nginx.
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
}
erp.aayunexinnovations.com, dealer.aayunexinnovations.com, pilot.aayunexinnovations.com, admin.aayunexinnovations.com {
	import fuelguardx_erp
}
