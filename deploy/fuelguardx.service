[Unit]
Description=Fuel Guard X - Django API (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
# NOTE: runs as root only because the code lives under /root (mode 700). The
# sandbox directives below shrink the blast radius. To drop to an unprivileged
# user later, relocate the project out of /root (e.g. /opt/fuelguardx) and set
# User=fuelguardx + ReadWritePaths.
User=root
WorkingDirectory=/root/erp/backend
ExecStart=/root/erp/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3
KillMode=mixed

# --- sandboxing / hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
